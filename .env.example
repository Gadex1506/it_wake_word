# it_wake_word/.env
# =====================================================
# Configuracion del proceso de deteccion de wake word.
# Un valor vacio equivale a "usar el valor por defecto".
# =====================================================

# Modelo de la palabra de activacion: nombre de un .onnx en ./models
# (sin extension) o ruta completa a un .onnx. Por defecto: meeah (Mia)
WAKE_WORD_MODEL=meeah

# Umbral de deteccion (0.0 a 1.0). Por defecto: 0.5
# Valores mas altos = menos falsos positivos
# Valores mas bajos = mas sensible, mas falsos positivos
WAKE_WORD_THRESHOLD=0.5

# Frames consecutivos (de 80 ms) sobre el umbral para confirmar la
# deteccion. Por defecto: 1. Con 2 o 3 se reducen los falsos positivos
# y permite bajar el umbral; afinar probando con voz real.
WAKE_WORD_PATIENCE=1

# Compuerta de energia: por debajo de este nivel RMS (escala int16,
# 0-32768) no se ejecuta el modelo, lo que ahorra casi toda la CPU
# cuando no hay nadie hablando. 0 = desactivada (por defecto).
# Calibrar: debe ser mayor que el ruido ambiente y menor que tu voz
# hablando normal. Ver "Optimizacion" en el README.
ENERGY_GATE_RMS=0

# Puerto donde Unity escucha las notificaciones de wake word
UNITY_SOCKET_PORT=9000

# Host de Unity. Localhost si Unity y el proceso corren en la misma maquina
UNITY_SOCKET_HOST=127.0.0.1

# Microfono a usar, por nombre: un fragmento del nombre (sin importar
# mayusculas ni tildes), p. ej. Arctis. Conviene que sea el mismo que
# usa Unity para grabar el comando. Vacio, o sin coincidencia = microfono
# por defecto del sistema (con aviso en el log).
# Para ver los nombres disponibles: python -m scripts.list_microphones
MICROPHONE_NAME=

# Alternativa: indice exacto del microfono. Tiene prioridad sobre
# MICROPHONE_NAME, pero el indice cambia de un PC a otro.
# None = no usar indice.
MICROPHONE_INDEX=None
