# it_wake_word/.env
# =====================================================
# Configuracion del proceso de deteccion de wake word
# =====================================================

# Nombre de la palabra de activacion (provisional)
WAKE_WORD_MODEL=

# Umbral de deteccion (0.0 a 1.0)
# Valores mas altos = menos falsos positivos
# Valores mas bajos = mas sensible para mas falsos positivos
WAKE_WORD_THRESHOLD=

# Puerto donde Unity escucha las notificaciones de wake word
UNITY_SOCKET_PORT=

# Host de Unity. Localhost si Unity y el proceso corren en la misma maquina
UNITY_SOCKET_HOST=

# Indice del microfono a usar. None = microfono por defecto del sistema
MICROPHONE_INDEX=